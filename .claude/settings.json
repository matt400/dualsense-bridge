{
  "permissions": {
    "allow": [
      "Bash(./tests/run_tests.sh)",
      "Bash(python3 tests/:*)",
      "Bash(python3 tools/screenshots.py:*)",
      "Bash(ruff check:*)",
      "Bash(python3 -m mypy:*)",
