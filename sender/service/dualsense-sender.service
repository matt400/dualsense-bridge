# Nadajnik DualSense bridge jako usługa systemd - działa jako root: wibracja przez /dev/hidraw, tryb niskich
# opóźnień. Instalacja: doas ./install-service.sh (podstawia @DIR@, @REPO@ i @ARGS@)
[Unit]
Description=DualSense bridge sender
After=bluetooth.target network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=@DIR@
# klucz HMAC (PADKEY) z --key instalatora - plik 0600 zamiast ExecStart widocznego w ps
EnvironmentFile=-/etc/dualsense-sender.env
ExecStart=/usr/bin/python3 -u @DIR@/sender_controller.py @ARGS@
Restart=always
RestartSec=2
# Ograniczenia (docs/SECURITY.md): bez zdobywania nowych uprawnień, system plików tylko do odczytu poza repozytorium
# (aktualizacja git pull, pliki stanu), /home tylko do odczytu. /dev i /sys zostają (hidraw, evdev, lightbar, rfkill,
# PM QoS). Coś nie działa po aktualizacji systemu? doas systemctl edit dualsense-sender i wyzeruj wybraną opcję.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@REPO@
PrivateTmp=yes
ProtectKernelModules=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
