# DualSense bridge sender as a systemd service - runs as root: rumble through /dev/hidraw, the low-latency mode.
# Installation: doas ./install-service.sh (substitutes @DIR@, @REPO@ and @ARGS@)
[Unit]
Description=DualSense bridge sender
After=bluetooth.target network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=@DIR@
# klucz HMAC (PADKEY) z --key instalatora - plik 0600 zamiast ExecStart widocznego w ps
EnvironmentFile=-/etc/dualsense-sender.env
ExecStart=/usr/bin/python3 -u @DIR@/sender_controller.py @ARGS@
Restart=always
RestartSec=2
# Restrictions (docs/SECURITY.md): no gaining new privileges, a read-only file system outside the repository
# (git pull updates, state files), a read-only /home. /dev and /sys stay (hidraw, evdev, lightbar, rfkill,
# PM QoS). Something stopped working after a system update? doas systemctl edit dualsense-sender and reset the option.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@REPO@
PrivateTmp=yes
ProtectKernelModules=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
